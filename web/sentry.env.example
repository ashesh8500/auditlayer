# AuditLayerMedia web Sentry activation (Vercel build/runtime)
# Runtime capture stays disabled unless a DSN and exact 40-hex release are both available.
SENTRY_DSN=https://PUBLIC_KEY@SENTRY_HOST/PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@SENTRY_HOST/PROJECT_ID
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Vercel supplies VERCEL_GIT_COMMIT_SHA. The Sentry build plugin uses that exact
# release and injects SENTRY_RELEASE into the browser bundle when upload credentials
# below are configured. For non-Vercel builds, set both release keys to the same
# exact deployed 40-hex Git SHA; never leave a stale static release on Vercel.
# SENTRY_RELEASE=0000000000000000000000000000000000000000
# NEXT_PUBLIC_SENTRY_RELEASE=0000000000000000000000000000000000000000

# Required together for production source-map upload. The auth token is build-only.
SENTRY_ORG=YOUR_SENTRY_ORG
SENTRY_PROJECT=YOUR_WEB_PROJECT
SENTRY_AUTH_TOKEN=YOUR_BUILD_ONLY_SENTRY_AUTH_TOKEN

# Sentry issue-alert webhook HMAC secret. Configure the same value in Sentry.
SENTRY_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET

# Tracing, replay, breadcrumbs, request bodies, local variables, and source context
# are intentionally disabled by source policy; no sample-rate variables are used.
