      "note": "W010 canonical founder transition matrix: approve/requeue target queued, block targets blocked."
    },
    {
      "id": "founder_transition_rpc",
      "path": "supabase/migrations/20260807130000_founder_audit_transition.sql",
      "kind": "sql_rpc_target_status",
      "expected": ["queued", "blocked"],
      "note": "W010 compare-and-transition RPC writes queued (approve/requeue) or blocked (block) exactly once under a locked row."
    },
    {
      "id": "sql_claim",
      "path": "supabase/migrations/0016_claim_rpc.sql",
      "kind": "sql_status_literals",
      "expected": ["queued", "running"]
