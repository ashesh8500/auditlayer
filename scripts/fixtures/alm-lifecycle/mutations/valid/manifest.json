{
  "schema_version": "1.0.0",
  "artifact": "fixture-base",
  "canonical_audit_states": [
    "draft",
    "queued",
    "running",
    "ready",
    "needs_review",
    "blocked",
    "failed"
  ],
  "authoritative_owner": {
    "id": "worker_core_enum",
    "path": "sources/core.py",
    "kind": "python_enum",
    "symbol": "AuditStatus"
  },
  "mirrors": [
    {
      "id": "web_domain_type",
      "path": "sources/domain.ts",
      "kind": "ts_type_union",
      "symbol": "AuditStatus"
    }
  ],
  "producers": [
    {
      "id": "admin_actions",
      "path": "sources/admin.ts",
      "kind": "ts_update_status",
      "expected": ["queued", "blocked", "ready"]
    }
  ],
  "consumers": [
    {
      "id": "client_status_active",
      "path": "sources/client-status.ts",
      "kind": "ts_string_array",
      "symbol": "ACTIVE",
      "expected": ["queued", "running"],
      "projection": "customer"
    },
    {
      "id": "client_status_terminal",
      "path": "sources/client-status.ts",
      "kind": "ts_string_array",
      "symbol": "TERMINAL",
      "expected": ["ready", "failed", "blocked", "needs_review"],
      "projection": "customer"
    },
    {
      "id": "dashboard_filters",
      "path": "sources/dashboard.ts",
      "kind": "ts_string_array",
      "symbol": "FILTERABLE_STATUSES",
      "expected": ["all", "running", "ready", "queued", "failed", "needs_review", "draft", "blocked"],
      "extra_allowed": ["all"],
      "projection": "customer"
    }
  ],
  "separate_vocabularies": [
    {
      "id": "report_generation_runs",
      "owner": "fixture report-attempt telemetry",
      "literals": ["running", "ready", "needs_review", "failed", "blocked", "crashed"],
      "distinctive": ["crashed"],
      "sources": [
        {
          "path": "sources/report.sql",
          "kind": "sql_check_constraint",
          "column": "status"
        }
      ]
    }
  ],
  "conflation_guards": ["crashed", "completed", "succeeded", "delayed"],
  "excluded_sources": []
}
